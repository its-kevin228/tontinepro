generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────────────────────

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String // Hash bcrypt — jamais exposé dans les réponses API
  role       UserRole   @default(MEMBRE)
  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false)
  otpCode    String?
  otpExpires DateTime?
  image      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  memberships            Membership[]
  createdCircles         Circle[]
  kycRequest             KycRequest?
  payments               Payment[]
  notifications          Notification[]
  banLogsAsTarget        BanLog[]                @relation("BanTarget")
  banLogsAsAdmin         BanLog[]                @relation("BanAdmin")
  notificationPreference NotificationPreference?
  disputes               Dispute[]               @relation("DisputeReporter")
}

enum UserRole {
  SUPER_ADMIN
  ORGANISATEUR
  MEMBRE
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
}

// ─── Circle ────────────────────────────────────────────────────────────────

model Circle {
  id          String       @id @default(cuid())
  creatorId   String
  name        String
  description String?
  amount      Float
  frequency   Frequency
  maxMembers  Int
  isPublic    Boolean      @default(false)
  status      CircleStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  creator     User         @relation(fields: [creatorId], references: [id])
  memberships Membership[]
  cycles      Cycle[]
  invitations Invitation[]
  disputes    Dispute[]
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum CircleStatus {
  PENDING
  ACTIVE
  CLOSED
}

// ─── Membership ────────────────────────────────────────────────────────────

model Membership {
  id       String         @id @default(cuid())
  userId   String
  circleId String
  role     MembershipRole @default(MEMBRE)
  order    Int?
  joinedAt DateTime       @default(now())

  user     User      @relation(fields: [userId], references: [id])
  circle   Circle    @relation(fields: [circleId], references: [id])
  payments Payment[]

  @@unique([userId, circleId])
}

enum MembershipRole {
  ORGANISATEUR
  MEMBRE
}

// ─── Cycle ─────────────────────────────────────────────────────────────────

model Cycle {
  id          String      @id @default(cuid())
  circleId    String
  number      Int
  startDate   DateTime
  endDate     DateTime?
  beneficiary String?
  status      CycleStatus @default(OPEN)
  createdAt   DateTime    @default(now())

  circle   Circle    @relation(fields: [circleId], references: [id])
  payments Payment[]
}

enum CycleStatus {
  OPEN
  CLOSED
  ARCHIVED
}

// ─── Payment ───────────────────────────────────────────────────────────────

model Payment {
  id           String        @id @default(cuid())
  userId       String
  cycleId      String
  membershipId String
  amount       Float
  method       PaymentMethod @default(CASH)
  status       PaymentStatus @default(PENDING)
  confirmedAt  DateTime?
  receiptUrl   String?
  createdAt    DateTime      @default(now())

  user       User       @relation(fields: [userId], references: [id])
  cycle      Cycle      @relation(fields: [cycleId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])
}

enum PaymentMethod {
  CASH
  VIREMENT
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// ─── Invitation ────────────────────────────────────────────────────────────

model Invitation {
  id        String           @id @default(cuid())
  circleId  String
  token     String           @unique @default(cuid())
  email     String?
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  circle Circle @relation(fields: [circleId], references: [id])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─── KYC ───────────────────────────────────────────────────────────────────

model KycRequest {
  id              String    @id @default(cuid())
  userId          String    @unique
  documentUrl     String
  status          KycStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewNote      String?
  // OCR
  ocrText         String? // texte brut extrait du document
  ocrConfidence   Float? // score de correspondance du nom (0-100)
  ocrAutoApproved Boolean   @default(false) // true si validé automatiquement
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Platform Settings ─────────────────────────────────────────────────────

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Ban Log ───────────────────────────────────────────────────────────────

model BanLog {
  id        String    @id @default(cuid())
  targetId  String
  adminId   String
  action    BanAction
  reason    String?
  createdAt DateTime  @default(now())

  target User @relation("BanTarget", fields: [targetId], references: [id])
  admin  User @relation("BanAdmin", fields: [adminId], references: [id])
}

enum BanAction {
  BAN
  UNBAN
}

// ─── Notification Preferences ──────────────────────────────────────────────

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  emailReminders Boolean  @default(true) // rappels 24h avant échéance
  emailPayment   Boolean  @default(true) // confirmation de paiement
  emailKyc       Boolean  @default(true) // décisions KYC
  inAppAll       Boolean  @default(true) // toutes les notifs in-app
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─── Litige ────────────────────────────────────────────────────────────────

model Dispute {
  id          String        @id @default(cuid())
  circleId    String
  reporterId  String
  targetId    String? // membre visé (optionnel)
  subject     String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  circle   Circle @relation(fields: [circleId], references: [id])
  reporter User   @relation("DisputeReporter", fields: [reporterId], references: [id])
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}
